# LeadScout configuration. Copy to ".env" and adjust as needed.
# All values have sensible defaults; you can run with an empty .env.

# --- Database ---
DB_PATH=data/leadscout.db

# --- OpenStreetMap services (100% free, no API key, no billing) ---
NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# Free Overpass mirrors, tried in order until one answers (comma-separated).
# The defaults below already include several public mirrors — you normally
# don't need to change this.
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.private.coffee/api/interpreter

# Nominatim asks for an identifying User-Agent with a contact address.
# Please change the email to your own before running heavy searches.
USER_AGENT=LeadScout/1.0 (you@example.com)

# --- Your details (used in outreach emails & call scripts) ---
# Copy this file to ".env" and fill in your own. Leave any blank to keep the
# editable [ ] placeholder in the generated text.
SELLER_NAME=Your Name
SELLER_COMPANY=Your Company
SELLER_PHONE=
SELLER_EMAIL=

# --- Sending email from the app (batch send) ---
# For Gmail: turn on 2-Step Verification, then create an "App Password"
# (Google Account > Security > App passwords) and paste it below. This is NOT
# your normal Gmail password. Leave blank to disable sending (drafts still work).
SELLER_EMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SEND_DELAY_SECONDS=1.5     # pause between each sent email
MAX_BATCH_SEND=25          # most emails one "Send" can dispatch

# --- Performance / politeness caps ---
MAX_BUSINESSES=60          # max businesses analysed per city search
MAX_BUSINESSES_STATE=250   # max businesses analysed per whole-state search
ANALYZE_CONCURRENCY=16     # simultaneous website checks (higher = faster scans)
SITE_TIMEOUT=8             # seconds per website fetch
MAX_PAGE_BYTES=500000      # stop downloading a page after this many bytes
OVERPASS_TIMEOUT=60        # seconds for the Overpass query
CHECK_BROKEN_LINKS=false   # sample-check links on each site (slower; off = faster)
